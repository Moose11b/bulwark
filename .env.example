# ── Database ────────────────────────────────────────────────────
POSTGRES_DB=bulwark
POSTGRES_USER=bulwark
POSTGRES_PASSWORD=changeme_in_prod
DATABASE_URL=postgresql+asyncpg://bulwark:changeme_in_prod@postgres:5432/bulwark

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_in_prod
REDIS_URL=redis://:changeme_in_prod@redis:6379/0

# ── FastAPI ──────────────────────────────────────────────────────
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ENVIRONMENT=development
DEBUG=true

# Demo mode: when a scanner cannot run (tool not installed, API key unset),
# return illustrative sample findings instead of reporting the gap. Useful for
# demonstrating the platform without the full toolchain.
# Leave false for real assessments — with it off, Bulwark only ever reports
# what it actually observed, and discloses which scanners could not run.
DEMO_MODE=false
# Must match the origin the browser actually loads the frontend from.
# docker-compose publishes the frontend on host port 3001.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ── Scan credentials ─────────────────────────────────────────────
# Encrypts credentials used to scan an application's authenticated surface.
# Leave empty to disable the feature entirely — with no key the API refuses to
# accept credentials rather than storing them in cleartext.
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this makes existing stored credentials undecryptable; they must be
# re-entered.
CREDENTIAL_ENCRYPTION_KEY=

# How many scanner stages may run against a target at once (default 4).
# Higher finishes sooner but hits the scanned host harder. 1 = sequential.
SCAN_STAGE_CONCURRENCY=4

# ── Celery ──────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:changeme_in_prod@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme_in_prod@redis:6379/2

# ── Authentication ───────────────────────────────────────────────
# How users sign in to the dashboard/API:
#   local — built-in email/password (default; no external account needed)
#   oidc  — your own OIDC provider (Keycloak, Authentik, Authelia, ...)
#   clerk — Clerk-hosted auth (good for a managed/hosted deployment)
#   auto  — infer from the keys below (oidc if OIDC_ISSUER set, else clerk if
#           Clerk keys set, else local)
AUTH_MODE=local
# The frontend needs to know the mode at build/runtime too. Keep it in sync
# with AUTH_MODE (use the resolved value, not "auto").
NEXT_PUBLIC_AUTH_MODE=local

# First-run admin (local mode). On first start with an empty user table an
# admin is created. Leave the password blank to have a strong one generated
# and printed once in the backend logs (you'll be forced to change it on first
# login). Set one here only for automated setups — never commit a real one.
BOOTSTRAP_ADMIN_EMAIL=admin@bulwark.local
BOOTSTRAP_ADMIN_PASSWORD=

# ── Clerk (only needed when AUTH_MODE=clerk) ─────────────────────
# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_changeme
CLERK_PUBLISHABLE_KEY=pk_test_changeme
CLERK_WEBHOOK_SECRET=whsec_changeme

# ── Self-hosted auth via OIDC (set AUTH_MODE=oidc) ───────────────
# Point Bulwark at your own OIDC provider (Keycloak, Authentik, Authelia, ...)
# instead of Clerk. Set the issuer to enable it; leave empty to use Clerk.
# The issuer is the ONLY trusted token source — tokens from any other issuer
# are rejected before their keys are ever fetched.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Create a user on first valid login instead of requiring pre-provisioning.
# The first user into the default org becomes its admin.
OIDC_AUTO_PROVISION=false
OIDC_DEFAULT_ORG_SLUG=default
OIDC_DEFAULT_ROLE=analyst

# ── Stripe (billing) ─────────────────────────────────────────────
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_PUBLISHABLE_KEY=pk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
STRIPE_STARTER_PRICE_ID=price_changeme
STRIPE_PRO_PRICE_ID=price_changeme
STRIPE_ENTERPRISE_PRICE_ID=price_changeme

# ── External APIs ────────────────────────────────────────────────
SHODAN_API_KEY=changeme
VIRUSTOTAL_API_KEY=changeme
HIBP_API_KEY=changeme
ALIENVAULT_API_KEY=changeme
NVD_API_KEY=changeme

# ── Alerts ───────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# ── Next.js ──────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── ngrok (public tunnel for Clerk/Stripe webhooks) ──────────────
# Get authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
# Claim a free static domain: https://dashboard.ngrok.com/domains
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
