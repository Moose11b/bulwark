# Bulwark CLI — lean image for CI/CD pipeline scanning.
# Contains only what the standalone scan engine needs (no Postgres/Redis/Celery).
FROM python:3.12-slim

# Scanner binaries + minimal build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    dnsutils \
    curl \
    git \
    wget \
    unzip \
    perl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Nikto from source, pinned to a release tag for reproducible builds
RUN git clone --depth 1 --branch 2.6.1 https://github.com/sullo/nikto.git /opt/nikto && \
    ln -s /opt/nikto/program/nikto.pl /usr/local/bin/nikto && \
    chmod +x /opt/nikto/program/nikto.pl

# Nuclei, pinned. The unauthenticated releases/latest API lookup was
# rate-limited and broke builds intermittently; a pin needs no API call.
ARG NUCLEI_VERSION=3.9.0
RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then NA="amd64"; else NA="arm64"; fi && \
    wget -q "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_${NA}.zip" -O /tmp/nuclei.zip && \
    unzip -q /tmp/nuclei.zip nuclei -d /usr/local/bin/ && \
    chmod +x /usr/local/bin/nuclei && \
    rm /tmp/nuclei.zip && \
    nuclei -update-templates -silent 2>/dev/null || true

WORKDIR /app

# Only the dependencies the CLI path needs — no DB/web-server packages
COPY requirements-cli.txt .
RUN pip install --no-cache-dir -r requirements-cli.txt

# Copy only the app package (engine, scanners, analysis, cli)
COPY app/ ./app/

ARG BULWARK_VERSION=dev
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    BULWARK_VERSION=${BULWARK_VERSION}

ENTRYPOINT ["python", "-m", "app.cli"]
